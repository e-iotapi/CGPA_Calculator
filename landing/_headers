# Cloudflare Pages response headers, for the whole site: the landing page at
# / and the app at /calculator/ (ARCHITECTURE.md §7).
# MUST be allow-popups, or signInWithPopup silently fails.
/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
# Firebase sign-in frames its helper (/__/auth/iframe) inside the app, and the
# popup answers through it: framing it MUST stay allowed, or no one who is
# signed out can sign in.
/__/auth/*
  ! Content-Security-Policy
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/calculator/
  Cache-Control: no-cache
/calculator/index.html
  Cache-Control: no-cache
/calculator/flutter_service_worker.js
  Cache-Control: no-cache
/calculator/main.dart.js
  Cache-Control: no-cache
/calculator/flutter_bootstrap.js
  Cache-Control: no-cache
/calculator/flutter.js
  Cache-Control: no-cache
/calculator/version.json
  Cache-Control: no-cache
# UI_OPT O7.3: Flutter web file names aren't content-hashed, so not
# "immutable" — a short max-age with revalidation in the background.
/calculator/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/calculator/canvaskit/*
  Cache-Control: public, max-age=604800

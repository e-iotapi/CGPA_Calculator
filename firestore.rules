rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Only verified BITS Pilani campus accounts. The app checks this too, but
    // a client-side check is bypassable — this is the real enforcement.
    function isBits() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches(
             '(?i)^[^@]+@(goa|pilani|dubai|hyderabad)[.]bits-pilani[.]ac[.]in$');
    }

    function me() { return request.auth.token.email.lower(); }

    // An owner need not be a BITS account (ARCHITECTURE.md §5): the list in
    // owners/{email} is the only way a non-BITS address gets in.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && exists(/databases/$(db)/documents/owners/$(me()))
        && get(/databases/$(db)/documents/owners/$(me())).data.active == true;
    }

    function mayUse() { return isBits() || isOwner(); }

    // Anyone may ask whether they are on the list, so sign-in can decide.
    // Adding and removing owners waits for the audit log; until then it is
    // done in the Firebase console.
    match /owners/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && me() == email;
      allow list: if isOwner();
      allow write: if false;
    }

    // The published catalogue (ARCHITECTURE.md §1): not secret, one read per
    // new version. Written only by an owner's publish.
    match /catalog/{doc} {
      allow read: if mayUse();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, delete: if mayUse() && request.auth.uid == uid;
      allow create, update: if mayUse() && request.auth.uid == uid
        && request.resource.data.rev is int
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000;
    }

    // Bug reports / course requests. Write-only from the app: a signed-in user
    // can file one under their own uid, but nothing can be read back from the
    // client. Read them in the Firebase console, which bypasses these rules.
    match /reports/{reportId} {
      allow create: if mayUse()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000;
      allow read, update, delete: if false;
    }
  }
}

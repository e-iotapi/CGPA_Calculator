/android/app/release

# Local Netlify folder
.netlify

# Real transcript used by test/grading — personal data, kept out of the public repo.
test/fixtures/transcript.csv
test/fixtures/performance_sheet.json

# ERP academic reports: real grades, never commit
*.pdf

# The user's local files (reports, screenshots): never commit
sensitive_data_NO_COMMIT/

# Rules tests (test/rules)
node_modules/

# Firebase emulators (test/rules, tools/test_env)
firestore-debug.log
firebase-debug.log
ui-debug.log
.firebase/

# Seed snapshots: regenerated by build_snapshots_test.dart, dated off "now"
tools/test_env/out/
tools/course_reviews_out/

# Playwright reports, traces and screenshots (tools/e2e)
tools/e2e/out/

# Performance recordings (Safari/Chrome exports), local only
tools/perf_out/
